{
  "info": {
    "_postman_id": "b7f1c2d4-5e6a-4f7b-9c8d-1a2b3c4d5e6f",
    "name": "English Yaari - Backend Assignment",
    "description": "Postman collection for the teacher session booking REST API.\n\nRun order: create a user, create a teacher, create a session, then book and complete it. IDs are captured automatically into collection variables. Start the API with `npm run dev` (and optionally seed with `npm run seed`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness probe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "1. Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Verma\",\n  \"email\": \"rahul.verma@example.com\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Creates a user. Email must be unique (409 on duplicate)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data._id) {",
                  "  pm.collectionVariables.set('userId', body.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Get User Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "sessions"]
            },
            "description": "Aggregation pipeline endpoint returning upcomingSessions and completedSessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has both buckets', () => {",
                  "  pm.expect(body.data).to.have.keys(['user', 'upcomingSessions', 'completedSessions']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Users (helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        }
      ]
    },
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Create Teacher (supporting)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@example.com\",\n  \"specialization\": \"Spoken English\",\n  \"experience\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            },
            "description": "Not one of the six graded APIs; exists so a real teacherId can be used when creating sessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data._id) {",
                  "  pm.collectionVariables.set('teacherId', body.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Teachers (helper)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["teachers"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "2. Create Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-11-02T10:00:00.000Z\",\n  \"endTime\": \"2026-11-02T11:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"]
            },
            "description": "Creates an AVAILABLE session. endTime must be after startTime and the teacher must exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data._id) {",
                  "  pm.collectionVariables.set('sessionId', body.data._id);",
                  "  const start = new Date(body.data.startTime);",
                  "  start.setHours(0, 0, 0, 0);",
                  "  pm.collectionVariables.set('dateTimestamp', String(start.getTime()));",
                  "}",
                  "pm.test('status is AVAILABLE', () => pm.expect(body.data.status).to.eql('AVAILABLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Available Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                { "key": "dateTimestamp", "value": "{{dateTimestamp}}" }
              ]
            },
            "description": "Mandatory aggregation pipeline endpoint. Returns AVAILABLE sessions starting on the given day."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a sessions array', () => pm.expect(body.data.sessions).to.be.an('array'));",
                  "pm.test('all sessions are AVAILABLE', () => {",
                  "  body.data.sessions.forEach((s) => pm.expect(s.status).to.eql('AVAILABLE'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Book Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "book"]
            },
            "description": "Books an AVAILABLE session for an existing user (409 if already booked/completed)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('session is BOOKED', () => pm.expect(body.data.status).to.eql('BOOKED'));",
                  "pm.test('session has the user', () => pm.expect(body.data.userId).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Complete Session",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "complete"]
            },
            "description": "Marks a BOOKED session as COMPLETED and stores completedAt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('session is COMPLETED', () => pm.expect(body.data.status).to.eql('COMPLETED'));",
                  "pm.test('completedAt is set', () => pm.expect(body.data.completedAt).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "dateTimestamp", "value": "" }
  ]
}
